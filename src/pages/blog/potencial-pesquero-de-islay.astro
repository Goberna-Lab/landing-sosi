---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/global/Header.astro";
import HeaderLaptop from "../../components/global/HeaderLaptop.astro";
import HeaderMobile from "../../components/global/HeaderMobile.astro";
import ArticuloIslay from "../../components/sections/ArticuloIslay.astro";
import ArticuloIslayLaptop from "../../components/sections/laptop/ArticuloIslayLaptop.astro";
import ArticuloIslayMobile from "../../components/sections/mobile/ArticuloIslayMobile.astro";
---

<Layout
  title="El potencial pesquero de Islay — Sosi Aspilcueta"
  description="La provincia de Islay alberga uno de los litorales más ricos y productivos del sur del Perú."
>
  <!-- Desktop version (>= 1366px) -->
  <div class="desktop-only">
    <Header />
    <main>
      <ArticuloIslay />
    </main>
  </div>

  <!-- Laptop version (<= 1366px, > 430px) -->
  <div class="laptop-only">
    <HeaderLaptop />
    <main>
      <ArticuloIslayLaptop />
    </main>
  </div>

  <!-- Mobile version (<= 430px) -->
  <div class="mobile-only">
    <HeaderMobile />
    <main>
      <ArticuloIslayMobile />
    </main>
  </div>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import Header from "../components/global/Header.astro";
import HeaderLaptop from "../components/global/HeaderLaptop.astro";
import HeaderMobile from "../components/global/HeaderMobile.astro";
import BlogListado from "../components/sections/BlogListado.astro";
import BlogListadoLaptop from "../components/sections/laptop/BlogListadoLaptop.astro";
import BlogListadoMobile from "../components/sections/mobile/BlogListadoMobile.astro";
import { fetchArticles } from "../lib/bravo";

// Un solo fetch para las tres versiones: el sitio renderiza desktop/laptop/mobile a la
// vez en el DOM, así que si cada componente pidiera lo suyo serían tres llamadas
// idénticas por build. Si Bravo no responde esto tira, y el build falla a propósito.
const articles = await fetchArticles();
---

<Layout
  title="Blog — Sosi Aspilcueta"
  description="Ideas en voz alta: artículos y noticias de Sosi Aspilcueta, Teniente Alcaldesa de Mejía."
>
  <!-- Desktop version (>= 1366px) -->
  <div class="desktop-only">
    <Header />
    <main>
      <BlogListado articles={articles} />
    </main>
  </div>

  <!-- Laptop version (<= 1366px, > 430px) -->
  <div class="laptop-only">
    <HeaderLaptop />
    <main>
      <BlogListadoLaptop articles={articles} />
    </main>
  </div>

  <!-- Mobile version (<= 430px) -->
  <div class="mobile-only">
    <HeaderMobile />
    <main>
      <BlogListadoMobile articles={articles} />
    </main>
  </div>
</Layout>

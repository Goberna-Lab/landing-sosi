---
export interface Props {
  foto1?: string;
  foto2?: string;
  foto3?: string;
  foto4?: string;
  foto5?: string;
  foto6?: string;
}

const {
  foto1 = "/images/galeria-2.png",
  foto2 = "/images/galeria-3.png",
  foto3 = "/images/galeria-4.png",
  foto4 = "/images/galeria-1.png",
  foto5 = "/images/galeria-5.jpg",
  foto6 = "/images/galeria-6.jpg",
} = Astro.props;
---

<div
  id="galeria"
  class="relative overflow-hidden"
  style="width:var(--page);height:1184px;background:var(--color-white)"
>
  <!-- Title: Un camino de -->
  <p
    class="absolute z-[4] m-0"
    style="
      left:10.42%;
      top:9.54%;
      font-family:var(--font-heading);
      font-weight:800;
      font-size:clamp(2rem,3.91vw,4.6875rem);
      color:var(--color-black);
      letter-spacing:-0.1172vw;
      line-height:1;
    "
  >
    Un camino de
  </p>

  <!-- Title: servicio -->
  <p
    class="absolute z-[4] m-0"
    style="
      left:38.85%;
      top:9.71%;
      font-family:var(--font-heading);
      font-weight:400;
      font-size:clamp(2rem,3.91vw,4.6875rem);
      color:var(--color-red);
      line-height:1;
    "
  >
    servicio
  </p>

  <!-- Pill: Ver todo (top right) -->
  <a
    href="#"
    class="absolute z-[5] flex items-center justify-center rounded-[76px] no-underline uppercase"
    style="
      left:73.28%;
      top:12.50%;
      width:8.11%;
      height:3.38%;
      border:1px solid var(--color-red);
      font-family:var(--font-body);
      font-weight:400;
      font-size:clamp(0.6875rem,0.625vw,0.75rem);
      color:var(--color-red);
    "
  >
    Ver todo
  </a>

  <!-- Card 6: image (x=296,y=256, 427x384) -->
  <div
    class="absolute z-[1] overflow-hidden rounded-[18px]"
    style="left:15.42%;top:21.62%;width:22.24%;height:32.43%"
  >
    <img
      src={foto4}
      alt=""
      class="w-full h-full object-cover"
    />
  </div>

  <!-- Card 3: image (x=747,y=256, 427x419) -->
  <div
    class="absolute z-[1] overflow-hidden rounded-[18px]"
    style="left:38.91%;top:21.62%;width:22.24%;height:35.39%"
  >
    <img
      src={foto1}
      alt=""
      class="w-full h-full object-cover"
    />
  </div>

  <!-- Card 4: image (x=1198,y=256, 427x384) -->
  <div
    class="absolute z-[1] overflow-hidden rounded-[18px]"
    style="left:62.40%;top:21.62%;width:22.24%;height:32.43%"
  >
    <img
      src={foto2}
      alt=""
      class="w-full h-full object-cover"
    />
  </div>

  <!-- Card 5: image (x=296,y=664, 427x300) -->
  <div
    class="absolute z-[1] overflow-hidden rounded-[18px]"
    style="left:15.42%;top:56.08%;width:22.24%;height:25.34%"
  >
    <img
      src={foto3}
      alt=""
      class="w-full h-full object-cover"
    />
  </div>

  <!-- Card 1: imagen (x=747,y=699, 427x265) -->
  <div
    class="absolute z-[1] overflow-hidden rounded-[18px]"
    style="left:38.91%; top:59.04%; width:22.24%; height:22.38%"
  >
    <img src={foto5} alt="" class="w-full h-full object-cover" />
  </div>

  <!-- Card 2: imagen (x=1198,y=664, 427x300) -->
  <div
    class="absolute z-[1] overflow-hidden rounded-[18px]"
    style="left:62.40%; top:56.08%; width:22.24%; height:25.34%"
  >
    <img src={foto6} alt="" class="w-full h-full object-cover" />
  </div>


  <!-- Main CTA: Ver todo -->
  <a
    href="#"
    class="absolute z-[7] flex items-center justify-center rounded-[6px] no-underline uppercase"
    style="
      left:42.66%;
      top:86.15%;
      width:14.64%;
      height:5.41%;
      background:var(--color-red);
      border:1px solid var(--color-red);
      font-family:var(--font-body);
      font-weight:400;
      font-size:clamp(0.9375rem,0.94vw,1.125rem);
      color:var(--color-white);
    "
  >
    Ver todo
  </a>
</div>

<div class="relative overflow-hidden" style="width:var(--page);height:457px">

  <div class="absolute inset-0 z-0" style="background:linear-gradient(90deg, var(--color-red) 1.88%, var(--color-red-dark) 63.44%, var(--color-red-darker) 100%, var(--color-red-deep) 116.2%)"></div>

  <!-- Sosi cutout (x=1231,y=50, 394x419) -->
  <img
    src="/images/sosi-cta.png"
    alt="Sosi Aspilcueta"
    class="absolute z-[1] object-contain object-top pointer-events-none"
    style="left:64.11%;top:10.94%;width:20.52%;height:91.68%"
  />

  <!-- "Únete" label -->
  <div class="absolute z-[1]" style="left:10.47%;top:15.54%">
    <span style="font-family:var(--font-body);font-weight:400;font-size:0.875rem;color:#fff;text-transform:uppercase;line-height:2.1875rem">Únete</span>
  </div>

  <!-- Title group -->
  <div class="absolute z-[1]" style="left:10.42%;top:35.23%">
    <span style="font-family:var(--font-heading);font-weight:800;font-size:3.4375rem;color:#fff;line-height:3.5rem;letter-spacing:-0.103rem">El futuro de de Mejía se construye</span>
  </div>
  <div class="absolute z-[1]" style="left:10.42%;top:45.08%">
    <span style="font-family:var(--font-heading);font-weight:400;font-size:3.4375rem;color:#fff;line-height:4.125rem;letter-spacing:-0.103rem">entre todos</span>
  </div>

  <!-- Button "ESCRÍBEME" -->
  <a href="#contacto" class="cta-escribeme absolute z-[1] inline-flex items-center justify-center" style="left:10.47%;top:65.86%;width:9.375rem;height:3rem;border-radius:var(--radius-sm);box-shadow:var(--shadow-header)">
    <span style="font-family:var(--font-body);font-weight:400;font-size:0.875rem;text-transform:uppercase;line-height:2.1875rem">ESCRÍBEME</span>
  </a>

</div>

<style>
  .cta-escribeme {
    background: var(--color-white);
    color: var(--color-red);
    border: 1px solid var(--color-red);
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  /* Al invertirse, el fondo del boton iguala al de la seccion (roja):
     el borde blanco mantiene el boton visible */
  .cta-escribeme:hover,
  .cta-escribeme:focus-visible {
    background: var(--color-red);
    color: var(--color-white);
    border-color: var(--color-white);
  }
</style>

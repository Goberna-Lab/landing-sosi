---
export interface Props {
  heroImage?: string;
  noiseBg?: string;
}

const { heroImage = "/landing-sosi/images/sosi-hero.png", noiseBg = "/landing-sosi/images/fondo-ruido.png" } = Astro.props;
---

<div style="position: relative; width: var(--page); height: 1080px; overflow: hidden; background: #1a1f2e;">

  <!-- White gradient overlay (back layer) -->
  <div style="position: absolute; top: 0; bottom: 0; left: 0; width: 63.9%; background: linear-gradient(269deg, rgba(255,255,255,0) 7.6%, #FFF 96.22%); opacity: 0.61; z-index: 0;"></div>

  <!-- Background noise (middle layer) -->
  <div style="position: absolute; inset: 0; z-index: 1;">
    <img src={noiseBg} alt="" style="width: 100%; height: 100%; object-fit: cover;" />
  </div>

  <!-- Dark multiply overlay (top layer) -->
  <div style="position: absolute; top: 0; bottom: 0; left: 0; width: 60.5%; background: linear-gradient(271deg, rgba(0,0,0,0) 9.19%, #696F7E 96.48%); mix-blend-mode: multiply; z-index: 2;"></div>

  <!-- Tagline -->
  <p style="position: absolute; left: 8.89%; top: 16.39%; z-index: 10; font-size: clamp(0.75rem, 0.833vw, 1rem); font-weight: 400; color: #fff; text-transform: uppercase; letter-spacing: 0.07em; opacity: 0.85; margin: 0;">
    Teniente Alcaldesa · Mejía, Arequipa
  </p>

  <!-- Name -->
  <h1 style="position: absolute; left: 8.88%; top: 25.28%; z-index: 10; font-size: clamp(3rem, 4.74vw, 5.6875rem); font-weight: 800; color: #fff; line-height: 1; margin: 0; font-family: var(--font-heading);">
    Sosi Aspilcueta
  </h1>

  <!-- Slogan -->
  <p style="position: absolute; left: 8.88%; top: 34.5%; z-index: 10; font-size: clamp(1.75rem, 2.5vw, 3rem); font-weight: 800; color: #fff; line-height: 1.2; margin: 0; font-family: var(--font-heading);">
    Siempre al servicio de Mejía
  </p>

  <!-- Description -->
  <p style="position: absolute; left: 8.88%; top: 42.24%; z-index: 10; font-size: clamp(1rem, 1.146vw, 1.375rem); font-weight: 400; color: #fff; line-height: 2rem; letter-spacing: 0.055rem; max-width: 31.7%; margin: 0;">
    Compromiso y experiencia.<br/>Transformemos juntos Mejía, con experiencia y compromiso.
  </p>

  <!-- CTA Button -->
  <a href="#sobre-mi" style="position: absolute; left: 8.88%; top: 59.72%; z-index: 10; display: inline-flex; align-items: center; justify-content: center; width: clamp(12rem, 14.95vw, 17.9375rem); height: clamp(2.75rem, 3.33vw, 4rem); background: #d70202; border-radius: 0.375rem; font-size: clamp(0.875rem, 0.9375vw, 1.125rem); color: #fff; text-decoration: none;">
    CONOCE MI HISTORIA
  </a>

  <!-- Photo mask -->
  <div style="position: absolute; left: 48.96%; top: 13.52%; width: 40.10%; height: 86.48%; z-index: 10; overflow: visible; pointer-events: none;">
    <img src={heroImage} alt="Sosi Aspilcueta" style="width: 100%; height: 100%; object-fit: contain; display: block;" />
  </div>

</div>

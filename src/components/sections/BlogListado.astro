---
interface Article {
  image: string;
  category: string;
  date: string;
  title: string;
  description: string;
  href: string;
}

const articles: Article[] = [
  {
    image: "/images/blog-thumb-1.png",
    category: "General",
    date: "19/05/2026",
    title: "El potencial pesquero de Islay: Propuestas para fortalecer la economía artesanal",
    description: "La provincia de Islay alberga uno de los litorales más ricos y productivos del sur del Perú.",
    href: "/blog/potencial-pesquero-de-islay",
  },
  {
    image: "/images/blog-thumb-2.png",
    category: "General",
    date: "19/05/2026",
    title: "Caminos seguros para quienes van a la escuela",
    description: "Movilidad, alumbrado y espacios públicos: tres decisiones simples que cambian la vida diaria.",
    href: "#",
  },
  {
    image: "/images/blog-listado-card-placeholder.png",
    category: "General",
    date: "19/05/2026",
    title: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt",
    description: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor",
    href: "#",
  },
  {
    image: "/images/blog-listado-card-placeholder.png",
    category: "General",
    date: "19/05/2026",
    title: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt",
    description: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor",
    href: "#",
  },
  {
    image: "/images/blog-listado-card-placeholder.png",
    category: "General",
    date: "19/05/2026",
    title: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt",
    description: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor",
    href: "#",
  },
  {
    image: "/images/blog-listado-card-placeholder.png",
    category: "General",
    date: "19/05/2026",
    title: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt",
    description: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor",
    href: "#",
  },
];
---

<div style="position: relative; width: 1920px; background: #fff;">
  <!-- Hero banner -->
  <div style="position: relative; width: 1920px; height: 600px; overflow: hidden;">
    <img src="/images/blog-listado-hero-bg.png" alt="" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;" />

    <!-- Left gradient for title legibility -->
    <div style="position: absolute; left: 0; top: 0; width: 1333px; height: 600px; background: linear-gradient(to right, rgba(0,0,0,0.5), rgba(0,0,0,0));"></div>

    <!-- Title -->
    <p style="position: absolute; left: 587px; top: 50%; transform: translateY(-50%); margin: 0; color: #fff; font-family: var(--font-heading); font-size: 75px; line-height: 74.03px; letter-spacing: -2.25px; white-space: nowrap;">
      <span style="font-weight: 800;">Ideas </span><span style="font-weight: 400;">en</span><br/><span style="font-weight: 400;">voz alta</span>
    </p>

    <!-- Sosi photo -->
    <img src="/images/blog-listado-sosi.png" alt="Sosi Aspilcueta" style="position: absolute; left: 928px; top: 61px; width: 404px; height: 539px; object-fit: cover; transform: scaleX(-1);" />
  </div>

  <!-- Breadcrumb + grid -->
  <div style="display: flex; flex-direction: column; gap: 56px; width: 1400px; margin: 55px auto 100px auto;">
    <div style="display: flex; align-items: center; gap: 10px; font-family: var(--font-body); font-weight: 700; font-size: 16px; line-height: 27.2px;">
      <a href="/" style="color: rgba(18,24,34,0.5); text-decoration: none;">Inicio</a>
      <span style="color: var(--color-black);">/</span>
      <span style="color: var(--color-black);">Blog</span>
    </div>

    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 50px;">
      {articles.map((article) => (
        <a href={article.href} class="blog-card-link" style="display: block; text-decoration: none;">
          <div style="width: 100%; height: 246.75px; border-radius: 8px; overflow: hidden;">
            <img src={article.image} alt="" style="width: 100%; height: 100%; object-fit: cover;" />
          </div>
          <div style="display: flex; align-items: center; gap: 10px; margin-top: 20px;">
            <div style="display: flex; align-items: center; justify-content: center; width: 78px; height: 34px; border-radius: 8px; background: var(--color-red);">
              <span style="font-family: var(--font-heading); font-weight: 700; font-size: 14px; color: #fff;">{article.category}</span>
            </div>
            <span style="font-family: var(--font-heading); font-weight: 600; font-size: 14px; line-height: 23.8px; color: rgba(18,24,34,0.5);">{article.date}</span>
          </div>
          <p style="margin: 20px 0 0 0; font-family: var(--font-heading); font-weight: 700; font-size: 20px; line-height: 24px; color: var(--color-black);">
            {article.title}
          </p>
          <p style="margin: 12px 0 0 0; font-family: var(--font-body); font-weight: 400; font-size: 16px; line-height: 24px; color: rgba(18,24,34,0.5);">
            {article.description}
          </p>
          <div style="display: flex; align-items: center; gap: 5px; margin-top: 16px;">
            <span class="blog-leer-mas" style="font-family: var(--font-heading); font-weight: 600; font-size: 16px; letter-spacing: 0.5px; color: var(--color-red);">Leer más</span>
            <img src="/images/icons/arrow-right-card-mobile.svg" alt="" style="width: 11px; height: auto;" />
          </div>
        </a>
      ))}
    </div>
  </div>
</div>

<script>
  const EXP_DATA_LAPTOP = [
    { year: "2022", description: "Ejercí como consultora especialista pesquero ambiental.", image: null },
    { year: "2021-2022", description: "Servicio especializado en INGENIERÍA PESQUERA para consejo regional – Gobierno Regional de Arequipa.", image: "/landing-sosi/images/laptop/experiencia-main.jpg" },
    { year: "2019", description: "Inspectora del Gobierno Regional de Arequipa en la Gerencia Regional de la Producción.", image: null },
    { year: "2017 -2018", description: "Encargada de la Dirección Zonal de Producción Islay – Gerencia Regional de la Producción en el Gobierno Regional de Arequipa.", image: null },
    { year: "2016-2017", description: "Sub Gerente de Pesca – Gerencia Regional de la Producción en el Gobierno Regional de Arequipa.", image: null },
    { year: "2015-2016", description: "Encargada de la Dirección Zonal de Islay – Gerencia Regional de la Producción en el Gobierno Regional de Arequipa.", image: null },
    { year: "2013-2014", description: "<span style=\"white-space:nowrap\">Inspector de seguimiento control y vigilancia de recursos hidrobiológicos –</span><br/>Gerencia Regional de la Producción en el Gobierno Regional de Arequipa.", image: null },
    { year: "2012-2013", description: "Inspector y supervisor desconcentrado de recursos hidrobiológicos en el Ministerio de la Producción.", image: null },
    { year: "2011 -2012", description: "Inspectora Agricultural Services – control de descarga para el SGS del Perú S.A.C.", image: null },
    { year: "2010", description: "Asistente técnico del PIP – Servicio Nacional de Áreas Protegidas por el Estado “SERNANP”.", image: null },
  ];

  const ACTIVE_STYLE_LAPTOP = { fontWeight: "800", fontSize: "45px", color: "#d70202" };
  const INACTIVE_STYLE_LAPTOP = { fontWeight: "700", fontSize: "19px", color: "#121822" };

  let activeIndexLaptop = 1;
  let firstRenderLaptop = true;

  function replayLaptop(el: HTMLElement | null) {
    if (!el) return;
    el.classList.remove("exp-fade-slide");
    void el.offsetWidth;
    el.classList.add("exp-fade-slide");
  }

  function renderExperienciaLaptop() {
    const section = document.getElementById("trayectoria-laptop");
    if (!section) return;

    section.querySelectorAll(".exp-year").forEach((el) => {
      const i = Number(el.getAttribute("data-index"));
      const style = i === activeIndexLaptop ? ACTIVE_STYLE_LAPTOP : INACTIVE_STYLE_LAPTOP;
      (el as HTMLElement).style.fontWeight = style.fontWeight;
      (el as HTMLElement).style.fontSize = style.fontSize;
      (el as HTMLElement).style.color = style.color;
    });

    section.querySelectorAll(".exp-dot").forEach((el) => {
      const i = Number(el.getAttribute("data-index"));
      const redDot = el.querySelector(".exp-dot-red") as HTMLElement | null;
      if (redDot) redDot.style.opacity = i === activeIndexLaptop ? "1" : "0";
    });

    const description = document.getElementById("exp-description-laptop");
    if (description) description.innerHTML = EXP_DATA_LAPTOP[activeIndexLaptop].description;

    const imageEl = document.getElementById("exp-image-laptop") as HTMLImageElement | null;
    const placeholderEl = document.getElementById("exp-placeholder-laptop");
    const currentImage = EXP_DATA_LAPTOP[activeIndexLaptop].image;
    if (imageEl && placeholderEl) {
      if (currentImage) {
        imageEl.src = currentImage;
        imageEl.style.display = "block";
        placeholderEl.style.display = "none";
      } else {
        imageEl.style.display = "none";
        placeholderEl.style.display = "block";
      }
    }

    if (!firstRenderLaptop) {
      replayLaptop(document.getElementById("exp-description-laptop"));
    }
    firstRenderLaptop = false;
  }

  document.getElementById("exp-next-laptop")?.addEventListener("click", () => {
    if (activeIndexLaptop < EXP_DATA_LAPTOP.length - 1) {
      activeIndexLaptop++;
      renderExperienciaLaptop();
    }
  });

  document.getElementById("exp-prev-laptop")?.addEventListener("click", () => {
    if (activeIndexLaptop > 0) {
      activeIndexLaptop--;
      renderExperienciaLaptop();
    }
  });

  renderExperienciaLaptop();
</script>

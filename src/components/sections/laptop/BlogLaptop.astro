    color: var(--color-red);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 4px;
    cursor: pointer;
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }

  .blog-link-laptop:hover,
  .blog-link-laptop:focus-visible {
    color: var(--color-red-dark);
    text-decoration-color: currentColor;
  }

  /* El de la card destacada va sobre foto oscura: aclarar en vez de oscurecer */
  .blog-link-laptop-on-dark:hover,
  .blog-link-laptop-on-dark:focus-visible {
    color: var(--color-white);
  }
</style>

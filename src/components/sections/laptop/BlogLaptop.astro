---
// Las dos notas del home ahora vienen de Bravo (las 2 más recientes).
// Ver la nota de Blog.astro sobre el corte del título en los dos puntos.
import type { BravoArticle } from "../../../lib/bravo";
import { articleHref } from "../../../lib/bravo";

export interface Props {
  articles: BravoArticle[];
}

const { articles } = Astro.props;

function partirTitulo(title: string): [string, string] {
  const i = title.indexOf(":");
  return i === -1 ? [title, ""] : [title.slice(0, i + 1), title.slice(i + 1)];
}

const RANURAS = [
  { thumbTop: "211px", tituloTop: "214px", descTop: "293px", linkTop: "366px" },
  { thumbTop: "456px", tituloTop: "456px", descTop: "525px", linkTop: "608px" },
];

const destacadas = articles.slice(0, RANURAS.length).map((a, i) => ({
  ...RANURAS[i],
  href: articleHref(a.slug),
  image: a.cover_image_url ?? "/images/laptop/blog-listado-card-placeholder.png",
  titulo: partirTitulo(a.title),
  excerpt: a.excerpt ?? "",
}));
---

<div style="position: relative; width: 1366px; height: 736px; background: #f5f7fa;">
  <!-- Title -->
  <div style="position: absolute; left: 80px; top: 80px; font-family: var(--font-heading); font-size: 55px; margin: 0;">
    <span style="font-weight: 800; color: #121822; letter-spacing: -0.03em;">Ideas </span>
    <span style="font-weight: 500; color: #d70202;">en voz alta</span>
  </div>

  <!-- Ver todo pill -->
  <a href="/blog" class="blog-pill-laptop" style="position: absolute; left: 1130px; top: 100px; display: flex; align-items: center; justify-content: center; width: 156px; height: 40px; border-radius: 76px; cursor: pointer; text-decoration: none;">
    <span style="font-size: 12px; text-transform: uppercase;">Ver todo</span>
  </a>

  <!-- Featured card -->
  <div style="position: absolute; left: 80px; top: 211px; width: 589px; height: 445px; border-radius: 10px; overflow: hidden;">
    <!-- Noise background -->
    <div style="position: absolute; inset: 0;">
      <img src="/images/blog-featured-bg.png" alt="" style="width: 100%; height: 100%; object-fit: cover;" />
    </div>
    <!-- Sosi photo -->
    <div style="position: absolute; left: 127px; top: 35px; width: 337px; height: 408px;">
      <img src="/images/laptop/sosi-blog.png" alt="Sosi Aspilcueta" style="width: 100%; height: 100%; object-fit: contain; object-position: top;" />
    </div>
    <!-- Gradient overlay -->
    <div style="position: absolute; bottom: 0; left: 0; right: 0; height: 113px; background: linear-gradient(to bottom, rgba(18,24,34,0), #121822);"></div>
    <!-- Text overlay -->
    <p style="position: absolute; left: 29px; bottom: 55px; font-family: var(--font-heading); font-weight: 500; font-size: 22px; color: #fff; margin: 0;">Conoce más sobre mí</p>
    <a href="/blog" class="blog-link-laptop blog-link-laptop-on-dark" style="position: absolute; right: 36px; bottom: 55px; font-family: var(--font-heading); font-weight: 500; font-size: 18px; margin: 0;">Leer artículo</a>
  </div>

  {destacadas.map((nota) => (
    <Fragment>
      <div style={`position: absolute; left: 701px; top: ${nota.thumbTop}; width: 200px; height: 200px; border-radius: 10px; overflow: hidden;`}>
        <img src={nota.image} alt="" style="width: 100%; height: 100%; object-fit: cover;" />
      </div>

      <p style={`position: absolute; left: 926px; top: ${nota.tituloTop}; width: 346px; font-family: var(--font-heading); font-size: 20px; line-height: 24px; margin: 0;`}>
        <span style="font-weight: 700; color: #121822;">{nota.titulo[0]}</span>
        <span style="font-weight: 500; color: #121822;">{nota.titulo[1]}</span>
      </p>

      <p style={`position: absolute; left: 926px; top: ${nota.descTop}; width: 346px; font-size: 16px; font-weight: 400; color: #121822; line-height: 24px; margin: 0;`}>{nota.excerpt}</p>

      <a href={nota.href} class="blog-link-laptop" style={`position: absolute; left: 926px; top: ${nota.linkTop}; font-family: var(--font-heading); font-weight: 500; font-size: 18px; margin: 0;`}>Leer artículo</a>
    </Fragment>
  ))}
</div>

<style>
  .blog-pill-laptop {
    border: 1px solid var(--color-red);
    color: var(--color-red);
    background: transparent;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .blog-pill-laptop:hover,
  .blog-pill-laptop:focus-visible {
    background: var(--color-red);
    color: var(--color-white);
  }

  /* "Leer articulo": subrayado que aparece al pasar el cursor */
  .blog-link-laptop {
    color: var(--color-red);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 4px;
    cursor: pointer;
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }

  .blog-link-laptop:hover,
  .blog-link-laptop:focus-visible {
    color: var(--color-red-dark);
    text-decoration-color: currentColor;
  }

  /* El de la card destacada va sobre foto oscura: aclarar en vez de oscurecer */
  .blog-link-laptop-on-dark:hover,
  .blog-link-laptop-on-dark:focus-visible {
    color: var(--color-white);
  }
</style>

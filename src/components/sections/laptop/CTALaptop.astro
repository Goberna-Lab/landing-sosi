<div style="position: relative; width: 1366px; height: 457px; overflow: hidden; background: linear-gradient(90deg, #d70202 1.88%, #b30202 63.44%, #980202 100%, #6c0101 116.2%);">
  <!-- Foto recortada (máscara 394×419 desde x=776,y=50 en Figma) -->
  <img
    src="/images/laptop/sosi-cta.png"
    alt="Sosi Aspilcueta"
    style="position: absolute; left: 776px; top: 50px; width: 394px; height: 419px; object-fit: contain; object-position: top; pointer-events: none;"
  />
  <!-- Únete label -->
  <p style="position: absolute; left: 81px; top: 71px; font-size: 14px; font-weight: 400; color: #fff; text-transform: uppercase; margin: 0;">Únete</p>

  <!-- Title -->
  <div style="position: absolute; left: 80px; top: 130px; font-family: var(--font-heading); font-size: 55px; letter-spacing: -0.03em; color: #fff; margin: 0;">
    <p style="font-weight: 800; line-height: 56px; margin: 0;">El futuro de Mejía</p>
    <p style="font-weight: 800; line-height: 56px; margin: 0;">se construye</p>
    <p style="font-weight: 400; font-size: 55px; margin: 0; margin-top: 4px;">entre todos</p>
  </div>

  <!-- ESCRÍBEME button -->
  <a href="#contacto-laptop" class="cta-escribeme" style="position: absolute; left: 81px; top: 329px; display: flex; align-items: center; justify-content: center; width: 150px; height: 48px; border-radius: 6px; box-shadow: 0 3px 6px 0 rgba(0,0,0,0.16); cursor: pointer;">
    <span style="font-size: 14px; text-transform: uppercase;">ESCRÍBEME</span>
  </a>
</div>

<style>
  .cta-escribeme {
    background: var(--color-white);
    color: var(--color-red);
    border: 1px solid var(--color-red);
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  /* Al invertirse, el fondo del boton iguala al de la seccion (roja):
     el borde blanco mantiene el boton visible */
  .cta-escribeme:hover,
  .cta-escribeme:focus-visible {
    background: var(--color-red);
    color: var(--color-white);
    border-color: var(--color-white);
  }
</style>

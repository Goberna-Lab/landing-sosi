---
// Detalle de artículo (laptop, 1366px). Ver la nota de ArticuloDetalle.astro sobre
// por qué el cuerpo va en una sola columna.
import type { BravoArticle } from '../../../lib/bravo';
import { formatDate, articleHref } from '../../../lib/bravo';
import { sanitizeHtml } from '../../../lib/sanitizeHtml';

interface Props {
  article: BravoArticle;
  recent: BravoArticle[];
}

const { article, recent } = Astro.props;
const categoria = article.category ?? 'General';
const fecha = formatDate(article.published_at);
const cuerpo = sanitizeHtml(article.body_html ?? '');
---

<div style="width: 1366px; background: #fff;">
  <div style="display: flex; gap: 27px; align-items: flex-start; width: 1307px; margin: 55px auto 100px auto;">
    <!-- Main content -->
    <div style="display: flex; flex-direction: column; gap: 27px; width: 980px;">
      <div>
        <div style="display: flex; align-items: center; gap: 10px; font-family: var(--font-body); font-weight: 700; font-size: 16px; line-height: 27.2px;">
          <a href="/" style="color: rgba(18,24,34,0.5); text-decoration: none;">Inicio</a>
          <span style="color: var(--color-black);">/</span>
          <span style="color: rgba(18,24,34,0.5);">{categoria}</span>
          <span style="color: var(--color-black);">/</span>
          <span style="color: var(--color-black);">{article.title}</span>
        </div>

        <div style="display: flex; flex-direction: column; gap: 15px; margin-top: 27px;">
          <h1 style="margin: 0; font-family: var(--font-heading); font-weight: 700; font-size: 37.9px; line-height: 41.69px; color: var(--color-black);">
            {article.title}
          </h1>
          <div style="display: flex; align-items: center; gap: 10px;">
            <div style="display: flex; align-items: center; justify-content: center; min-width: 77px; height: 34px; padding: 0 12px; border-radius: 8px; background: var(--color-red);">
              <span style="font-family: var(--font-heading); font-weight: 700; font-size: 14px; color: #fff;">{categoria}</span>
            </div>
            <span style="font-family: var(--font-heading); font-weight: 600; font-size: 14px; color: rgba(18,24,34,0.5);">{fecha}</span>
          </div>
        </div>
      </div>

      {article.cover_image_url && (
        <div style="width: 100%; aspect-ratio: 980 / 735; border-radius: 8px; overflow: hidden;">
          <img src={article.cover_image_url} alt={article.title} style="width: 100%; height: 100%; object-fit: cover;" />
        </div>
      )}

      <div class="bravo-prose" style="--prose-size: 16px; --prose-lh: 27.2px;" set:html={cuerpo} />

      <div style="display: flex; align-items: center; gap: 10px; padding-bottom: 12px; border-bottom: 3px solid var(--color-red); width: 422px;">
        <span style="font-family: var(--font-heading); font-weight: 400; font-size: 16px; color: var(--color-black);">Compartir:</span>
        <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(Astro.url.href)}`} target="_blank" rel="noopener noreferrer" aria-label="Compartir en Facebook"><img src="/images/icons/share-facebook.svg" alt="" style="width: 16px; height: 16px;" /></a>
        <a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(Astro.url.href)}&text=${encodeURIComponent(article.title)}`} target="_blank" rel="noopener noreferrer" aria-label="Compartir en X"><img src="/images/icons/share-x.svg" alt="" style="width: 16px; height: 15px;" /></a>
        <a href={`https://t.me/share/url?url=${encodeURIComponent(Astro.url.href)}&text=${encodeURIComponent(article.title)}`} target="_blank" rel="noopener noreferrer" aria-label="Compartir en Telegram"><img src="/images/icons/share-telegram.svg" alt="" style="width: 17px; height: 14px;" /></a>
      </div>
    </div>

    <!-- Sidebar -->
    {recent.length > 0 && (
      <div style="display: flex; flex-direction: column; gap: 29px; width: 300px; flex-shrink: 0;">
        <p style="margin: 0; font-family: var(--font-heading); font-weight: 700; font-size: 21.3px; color: var(--color-black);">Post Recientes</p>
        <div style="display: flex; flex-direction: column; gap: 15px; width: 100%;">
          {recent.map((post) => (
            <a href={articleHref(post.slug)} style="display: flex; gap: 20px; align-items: flex-start; text-decoration: none;">
              <div style="width: 100px; height: 100px; border-radius: 8px; overflow: hidden; flex-shrink: 0;">
                <img src={post.cover_image_url ?? '/images/blog-listado-card-placeholder.png'} alt="" style="width: 100%; height: 100%; object-fit: cover;" />
              </div>
              <div style="display: flex; flex-direction: column; gap: 4px; padding-top: 2px;">
                <p style="margin: 0; font-family: var(--font-heading); font-weight: 700; font-size: 16px; line-height: 20.8px; color: var(--color-black);">{post.title}</p>
                <p style="margin: 0; font-family: var(--font-body); font-weight: 400; font-size: 12.4px; color: rgba(18,24,34,0.6);">{formatDate(post.published_at)}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</div>

  <div style="position: absolute; left: 80px; top: 337px; width: 1206px; height: 610px; background: #fff; border-radius: 0 0 10px 10px; box-shadow: 2px 10px 16px 0 rgba(196,196,196,0.8);"></div>

  <!-- Content: Mis raíces -->
  <div id="bio-content-0-laptop" class="absolute bio-slide-right" style="left:80px;top:337px;width:1206px;height:610px;display:block">
    <p style="position: absolute; left: 80px; top: 178px; width: 535px; font-family: var(--font-heading); font-weight: 700; font-size: 28px; color: #121822; line-height: 32px; margin: 0;">Nací el 20 de enero de 1986 en Mejía, distrito de mi amada Arequipa.</p>
    <p style="position: absolute; left: 80px; top: 292px; width: 577px; font-size: 16px; font-weight: 400; color: #121822; line-height: 32px; margin: 0;">Desde temprana edad, fui encaminada por la educación y el servicio a la comunidad, lo que me ha permitido construir una sólida trayectoria académica y profesional. Soy una mujer decidida a lograr mis objetivos en bienestar de mi comunidad.</p>
  </div>

  <!-- Content: Mi formación -->
  <div id="bio-content-1-laptop" class="absolute bio-slide-right" style="left:80px;top:337px;width:1206px;height:610px;display:none">
    <p style="position: absolute; left: 136px; top: 79px; width: 430px; font-family: var(--font-heading); font-weight: 700; font-size: 28px; color: #121822; line-height: 32px; margin: 0;">Preparación que impulsa<br/>mi propósito</p>

    <div style="position: absolute; left: 136px; top: 178px; width: 26px;"><img src="/images/icons/icon-cetpro.svg" alt="" style="width: 100%; height: auto;" /></div>
    <p style="position: absolute; left: 178px; top: 171px; width: 400px; font-size: 16px; font-weight: 400; color: #121822; line-height: 24px; margin: 0;"><span style="font-weight: 700;">CETPRO George Washington</span>, donde me<br/>especialicé en Computación e Informática</p>

    <div style="position: absolute; left: 137px; top: 258px; width: 25px;"><img src="/images/icons/icon-universidad.svg" alt="" style="width: 100%; height: auto;" /></div>
    <p style="position: absolute; left: 178px; top: 246px; width: 540px; font-size: 16px; font-weight: 400; color: #121822; line-height: 24px; margin: 0;"><span style="font-weight: 700;">Universidad Nacional de San Agustín de Arequipa</span>, donde<br/>obtuve mi título en Ingeniería Pesquera en 2009.</p>

    <div style="position: absolute; left: 136px; top: 334px; width: 26px;"><img src="/images/icons/noun_Diploma_1218634.svg" alt="" style="width: 100%; height: auto;" /></div>
    <p style="position: absolute; left: 178px; top: 322px; width: 560px; font-size: 16px; font-weight: 400; color: #121822; line-height: 24px; margin: 0;"><span style="font-weight: 700;">Maestría en Ciencias de Administración</span><br/>con mención en Gerencia del Estado y Administración Pública.</p>

    <p style="position: absolute; left: 137px; top: 430px; width: 507px; font-size: 15px; font-weight: 400; color: #121822; line-height: 24px; margin: 0;"><span style="font-weight: 700;">Mi formación en ingeniería pesquera me ha brindado una perspectiva valiosa</span> sobre la sostenibilidad y el desarrollo económico de las regiones costeras; asimismo, mi constante interés por la actualización académica ha reforzado mis habilidades para el desarrollo de proyectos y la gestión pública.</p>
  </div>

  <!-- Content: Mi experiencia -->
  <div id="bio-content-2-laptop" class="absolute bio-slide-right" style="left:80px;top:337px;width:1206px;height:610px;display:none">
    <p style="position: absolute; left: 136px; top: 87px; width: 430px; font-family: var(--font-heading); font-weight: 700; font-size: 28px; color: #121822; line-height: 32px; margin: 0;">Mi experiencia y liderazgo</p>

    <p style="position: absolute; left: 136px; top: 141px; width: 462px; font-size: 16px; font-weight: 400; color: #121822; line-height: 24px; margin: 0;"><span style="font-weight: 700;">He tenido el honor de desempeñarme como Alcaldesa de Mejía</span>, aplicando mi formación y experiencia para liderar proyectos innovadores y sostenibles que generan bienestar para nuestra comunidad.</p>

    <div style="position: absolute; left: 140px; top: 287px; width: 24px;"><img src="/images/icons/noun_dense_2855562.svg" alt="" style="width: 100%; height: auto;" /></div>
    <p style="position: absolute; left: 184px; top: 290px; font-size: 16px; font-weight: 400; color: #121822; margin: 0;"><span style="font-weight: 700;">Gestión Pública</span> con trasparencia</p>

    <div style="position: absolute; left: 138px; top: 347px; width: 27px;"><img src="/images/icons/noun_money_in_hand_3606493.svg" alt="" style="width: 100%; height: auto;" /></div>
    <p style="position: absolute; left: 184px; top: 348px; font-size: 16px; font-weight: 400; color: #121822; margin: 0;"><span style="font-weight: 700;">Desarrollo</span> sostenible</p>

    <div style="position: absolute; left: 142px; top: 405px; width: 21px;"><img src="/images/icons/noun_support_1156576.svg" alt="" style="width: 100%; height: auto;" /></div>
    <p style="position: absolute; left: 184px; top: 405px; font-size: 16px; font-weight: 400; color: #121822; margin: 0;"><span style="font-weight: 700;">Innovación</span> y tecnología</p>

    <div style="position: absolute; left: 141px; top: 461px; width: 23px;"><img src="/images/icons/noun_Business_2603804.svg" alt="" style="width: 100%; height: auto;" /></div>
    <p style="position: absolute; left: 184px; top: 462px; font-size: 16px; font-weight: 400; color: #121822; margin: 0;"><span style="font-weight: 700;">Compromiso</span> social</p>
  </div>

  <!-- Photo group -->
  <div id="bio-photo-laptop" class="absolute bio-slide-up" style="left:756px;top:417px;width:465px;height:450px;overflow:hidden;border-radius:10px">
    <img src="/images/laptop/biografia-foto-1.png" alt="" style="position: absolute; inset: 0; width: 100%; height: auto; min-height: 450px; object-fit: cover;" />
  </div>
</div>

<script>
  const tabsLaptop = document.querySelectorAll(".bio-tab-laptop") as NodeListOf<HTMLElement>;
  const contentsLaptop = [
    document.getElementById("bio-content-0-laptop"),
    document.getElementById("bio-content-1-laptop"),
    document.getElementById("bio-content-2-laptop"),
  ];
  const photoLaptop = document.getElementById("bio-photo-laptop");

  function replayBioLaptop(el: HTMLElement | null, className: string) {
    if (!el) return;
    el.classList.remove(className);
    void el.offsetWidth;
    el.classList.add(className);
  }

  tabsLaptop.forEach((tab, index) => {
    tab.addEventListener("click", () => {
      tabsLaptop.forEach((t) => {
        t.classList.remove("active");
        t.style.background = "transparent";
        const span = t.querySelector("span");
        if (span) (span as HTMLElement).style.color = "#121822";
      });

      tab.classList.add("active");
      tab.style.background = "#d70202";
      const activeSpan = tab.querySelector("span");
      if (activeSpan) (activeSpan as HTMLElement).style.color = "#fff";

      contentsLaptop.forEach((content, i) => {
        if (content) content.style.display = i === index ? "block" : "none";
      });

      replayBioLaptop(photoLaptop, "bio-slide-up");
    });
  });
</script>

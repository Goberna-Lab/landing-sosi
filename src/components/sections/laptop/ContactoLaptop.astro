<div id="contacto-laptop" style="position: relative; width: 1366px; height: 650px; background: #f5f7fa;">
  <!-- "Contacto" label -->
  <p style="position: absolute; left: 81px; top: 71px; font-size: 14px; font-weight: 400; color: #d70202; text-transform: uppercase; margin: 0;">Contacto</p>

  <!-- Title -->
  <div style="position: absolute; left: 120px; top: 129px; font-family: var(--font-heading); font-size: 55px; letter-spacing: -0.03em; margin: 0;">
    <p style="font-weight: 800; color: #121822; line-height: 1; margin: 0;">Conversemos</p>
    <p style="font-weight: 500; color: #121822; line-height: 1; margin: 0; margin-top: 5px;">Sobre Mejía</p>
  </div>

  <!-- Description -->
  <p style="position: absolute; left: 121px; top: 270px; width: 389px; font-size: 16px; font-weight: 400; color: #121822; line-height: 24px; margin: 0;">Es momento de renovar la política con vocación de servicio y trabajo real. Suma tu voz a esta causa: escríbeme y transformemos la realidad de Mejía juntos.</p>

  <!-- Email -->
  <p style="position: absolute; left: 121px; top: 393px; font-size: 14px; font-weight: 400; color: rgba(18,24,34,0.8); text-transform: uppercase; margin: 0;">Correo</p>
  <p style="position: absolute; left: 121px; top: 420px; font-size: 14px; font-weight: 400; color: rgba(18,24,34,0.5); margin: 0;">hola@gmail.com</p>

  <!-- Social -->
  <p style="position: absolute; left: 121px; top: 461px; font-size: 14px; font-weight: 400; color: rgba(18,24,34,0.8); text-transform: uppercase; margin: 0;">Redes sociales</p>
  <p style="position: absolute; left: 121px; top: 488px; font-size: 14px; font-weight: 400; color: #121822; margin: 0;">Instagram</p>
  <p style="position: absolute; left: 211px; top: 488px; font-size: 14px; font-weight: 400; color: #121822; margin: 0;">Facebook</p>

  <!-- Contact form card -->
  <div style="position: absolute; left: 657px; top: 80px; width: 514px; height: 525px; background: #fff; border-radius: 10px; box-shadow: 0 3px 6px 0 rgba(0,0,0,0.16); padding: 40px;">

    <!-- NOMBRES -->
    <p style="font-family: var(--font-heading); font-size: 10px; font-weight: 400; color: #1b1f28; text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 6px 0;">NOMBRES</p>
    <p style="font-size: 11px; font-weight: 400; color: rgba(27,31,40,0.6); letter-spacing: 0.08em; margin: 0 0 6px 0;">Tu nombre</p>
    <div style="width: 100%; height: 1px; background: #C0C1C7; margin-bottom: 16px;"></div>

    <!-- Correo -->
    <div style="display: flex; gap: 16px;">
      <div style="flex: 1;">
        <p style="font-family: var(--font-heading); font-size: 10px; font-weight: 400; color: #1b1f28; text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 6px 0;">Correo</p>
        <p style="font-size: 11px; font-weight: 400; color: rgba(27,31,40,0.6); letter-spacing: 0.08em; margin: 0 0 6px 0;">tucorreo@email.com</p>
        <div style="width: 100%; height: 1px; background: #C0C1C7; margin-bottom: 16px;"></div>
      </div>
      <div style="flex: 1;">
        <p style="font-family: var(--font-heading); font-size: 10px; font-weight: 400; color: #1b1f28; text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 6px 0;">Teléfono</p>
        <p style="font-size: 11px; font-weight: 400; color: rgba(27,31,40,0.6); letter-spacing: 0.08em; margin: 0 0 6px 0;">+51 000 000 000</p>
        <div style="width: 100%; height: 1px; background: #C0C1C7; margin-bottom: 16px;"></div>
      </div>
    </div>

    <!-- Distrito o sector -->
    <p style="font-family: var(--font-heading); font-size: 10px; font-weight: 400; color: #1b1f28; text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 6px 0;">Distrito o sector</p>
    <p style="font-size: 11px; font-weight: 400; color: rgba(27,31,40,0.6); letter-spacing: 0.08em; margin: 0 0 6px 0;">ej: Mejía, Deán Valdivia</p>
    <div style="width: 100%; height: 1px; background: #C0C1C7; margin-bottom: 16px;"></div>

    <!-- Motivo del mensaje -->
    <p style="font-family: var(--font-heading); font-size: 10px; font-weight: 400; color: #1b1f28; text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 6px 0;">Motivo del mensaje</p>
    <p style="font-size: 11px; font-weight: 400; color: #1b1f28; margin: 0 0 6px 0;">Seleccione</p>
    <div style="width: 100%; height: 1px; background: #C0C1C7; margin-bottom: 16px;"></div>

    <!-- Mensaje opcional -->
    <p style="font-family: var(--font-heading); font-size: 10px; font-weight: 400; color: #1b1f28; text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 6px 0;">Mensaje opcional</p>
    <p style="font-size: 11px; font-weight: 400; color: rgba(27,31,40,0.6); letter-spacing: 0.08em; margin: 0 0 6px 0;">Cuéntanos cómo te gustaría sumarte</p>
    <div style="width: 100%; height: 1px; background: #C0C1C7; margin-bottom: 20px;"></div>

    <!-- Submit button -->
    <div style="display: flex; align-items: center; justify-content: center; width: 175px; height: 42px; background: #d70202; border-radius: 6px; cursor: pointer;">
      <span style="font-size: 10px; color: #fff; text-transform: uppercase;">QUIERO SUMARME</span>
    </div>
  </div>

  <!-- Red gradient bar at bottom -->
  <div style="position: absolute; left: 0; bottom: 0; width: 100%; height: 30px; background: linear-gradient(90deg, #d70202 1.88%, #b30202 84.97%, #6c0101 111.44%);"></div>
</div>

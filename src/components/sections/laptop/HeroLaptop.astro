<!-- El frame de Figma (1366x620) incluye el header superpuesto. Como el header
     vive fuera (a nivel de pagina, para poder ser sticky), se sube el hero 72px
     para que la composicion quede igual en la primera vista. -->
<div style="position: relative; width: 1366px; height: 620px; margin-top: -72px; overflow: hidden;">
  <!-- Beach background -->
  <div style="position: absolute; inset: 0; overflow: hidden;">
    <img src="/images/laptop/playa.jpg" alt="" style="width: 100%; height: auto; min-height: 911px; object-fit: cover;" />
  </div>
  <!-- Gray overlay -->
  <div style="position: absolute; inset: 0; background: #f1f2f5; opacity: 0.44;"></div>
  <!-- Fondo del hero: foto de costa con grano, exportada a la medida del frame -->
  <div style="position: absolute; inset: 0;">
    <img src="/images/laptop/fondo-ruido.png" alt="" style="width: 1366px; height: 620px;" />
  </div>
  <!-- Dark multiply overlay -->
  <div style="position: absolute; top: 0; bottom: 0; left: 0; width: 928px; background: linear-gradient(270.7deg, rgba(0,0,0,0) 9.03%, #696F7E 96.73%); mix-blend-mode: multiply;"></div>

  <!-- Tagline -->
  <p style="position: absolute; left: 100px; top: 146px; width: 360px; height: 20px; font-size: 16px; line-height: 20px; font-weight: 400; color: #fff; text-align: center; text-transform: uppercase; white-space: nowrap; margin: 0;">
    Teniente Alcaldesa · Mejía, Arequipa
  </p>

  <!-- Name -->
  <p style="position: absolute; left: 100px; top: 230px; width: 518px; height: 78px; font-size: 64px; line-height: 78px; font-weight: 800; color: #fff; text-align: center; white-space: nowrap; margin: 0; font-family: var(--font-heading);">
    Sosi Aspilcueta
  </p>

  <!-- Slogan -->
  <p style="position: absolute; left: 100px; top: 308px; width: 506px; height: 42px; font-size: 34px; line-height: 42px; font-weight: 800; color: #fff; text-align: center; white-space: nowrap; margin: 0; font-family: var(--font-heading);">
    Siempre al servicio de Mejía
  </p>

  <!-- Description -->
  <div style="position: absolute; left: 100px; top: 366px; width: 489px; height: 42px; font-size: 16px; line-height: 22px; font-weight: 400; color: #fff; text-align: left; letter-spacing: 0.64px; white-space: nowrap; margin: 0;">
    Compromiso y experiencia.<br/>Transformemos juntos Mejía, con experiencia y compromiso.
  </div>

  <!-- CTA Button -->
  <a href="#sobre-mi" style="position: absolute; left: 100px; top: 432px; display: flex; align-items: center; justify-content: center; width: 200px; height: 48px; background: #d70202; border-radius: 6px; font-size: 14px; color: #fff; text-decoration: none;">
    CONOCE MI HISTORIA
  </a>

  <!-- Photo -->
  <img
    src="/images/laptop/sosi-hero.png"
    alt="Sosi Aspilcueta"
    style="position: absolute; left: 751px; top: 91px; width: 436px; height: 529px; object-fit: contain; max-width: none;"
  />

</div>

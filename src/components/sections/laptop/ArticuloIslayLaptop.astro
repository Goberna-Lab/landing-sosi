---
const relatedPosts = [
  {
    image: "/images/laptop/blog-thumb-2.jpg",
    title: "Caminos seguros para quienes van a la escuela",
    date: "12/03/2026",
  },
  {
    image: "/images/laptop/blog-listado-card-placeholder.png",
    title: "Lorem ipsum dolor sit amet, consectetur adipiscing elit",
    date: "27/03/2026",
  },
  {
    image: "/images/laptop/blog-listado-card-placeholder.png",
    title: "Lorem ipsum dolor sit amet, consectetur adipiscing elit",
    date: "21/04/2025",
  },
  {
    image: "/images/laptop/blog-listado-card-placeholder.png",
    title: "Lorem ipsum dolor sit amet, consectetur adipiscing elit",
    date: "21/04/2025",
  },
];
---

<div style="width: 1366px; background: #fff;">
  <div style="display: flex; gap: 27px; align-items: flex-start; width: 1307px; margin: 55px auto 100px auto;">
    <!-- Main content -->
    <div style="display: flex; flex-direction: column; gap: 27px; width: 980px;">
      <div>
        <div style="display: flex; align-items: center; gap: 10px; font-family: var(--font-body); font-weight: 700; font-size: 16px; line-height: 27.2px;">
          <a href="/" style="color: rgba(18,24,34,0.5); text-decoration: none;">Inicio</a>
          <span style="color: var(--color-black);">/</span>
          <span style="color: rgba(18,24,34,0.5);">General</span>
          <span style="color: var(--color-black);">/</span>
          <span style="color: var(--color-black);">El potencial pesquero de Islay: Propuestas para fortalecer la economía artesanal</span>
        </div>

        <div style="display: flex; flex-direction: column; gap: 15px; margin-top: 27px;">
          <h1 style="margin: 0; font-family: var(--font-heading); font-weight: 700; font-size: 37.9px; line-height: 41.69px; color: var(--color-black);">
            El potencial pesquero de Islay: Propuestas para fortalecer la economía artesanal
          </h1>
          <div style="display: flex; align-items: center; gap: 10px;">
            <div style="display: flex; align-items: center; justify-content: center; width: 77px; height: 34px; border-radius: 8px; background: var(--color-red);">
              <span style="font-family: var(--font-heading); font-weight: 700; font-size: 14px; color: #fff;">General</span>
            </div>
            <span style="font-family: var(--font-heading); font-weight: 600; font-size: 14px; color: rgba(18,24,34,0.5);">19/05/2026</span>
          </div>
        </div>
      </div>

      <div style="width: 100%; aspect-ratio: 980 / 735; border-radius: 8px; overflow: hidden;">
        <img src="/images/laptop/blog-thumb-1.jpg" alt="Pesca artesanal en Islay" style="width: 100%; height: 100%; object-fit: cover;" />
      </div>

      <p style="margin: 0; font-family: var(--font-body); font-weight: 400; font-size: 16px; line-height: 27.2px; color: var(--color-black);">
        La provincia de Islay alberga uno de los litorales más ricos y productivos del sur del Perú. Durante décadas, la pesca artesanal ha sido el motor silencioso de nuestras familias costeras, alimentando no solo a nuestros hogares, sino también abasteciendo a gran parte del mercado regional. Sin embargo, en un contexto global que exige innovación, sostenibilidad y mayor valor agregado, no podemos seguir viendo a la pesca artesanal con la mirada del siglo pasado. Es momento de transformar ese potencial latente en un verdadero motor de desarrollo económico local y equitativo.
      </p>

      <div style="display: flex; gap: 20px; align-items: flex-start; width: 100%;">
        <div style="display: flex; flex-direction: column; align-items: flex-start; gap: 50px; width: 422px;">
          <p style="margin: 0; width: 100%; font-family: var(--font-body); font-weight: 400; font-size: 16px; line-height: 27.2px; color: var(--color-black);">
            Para lograrlo, se requiere una visión técnica que combine el conocimiento del mar con una gestión pública moderna y eficiente. A continuación, comparto cuatro pilares estratégicos para fortalecer a nuestros pescadores artesanales y asegurar el futuro productivo de Islay.
          </p>
          <div style="display: flex; align-items: center; gap: 10px; padding-bottom: 12px; border-bottom: 3px solid var(--color-red);">
            <span style="font-family: var(--font-heading); font-weight: 400; font-size: 16px; color: var(--color-black);">Compartir:</span>
            <a href="#" aria-label="Compartir en Facebook"><img src="/images/icons/share-facebook.svg" alt="" style="width: 16px; height: 16px;" /></a>
            <a href="#" aria-label="Compartir en X"><img src="/images/icons/share-x.svg" alt="" style="width: 16px; height: 15px;" /></a>
            <a href="#" aria-label="Compartir en Telegram"><img src="/images/icons/share-telegram.svg" alt="" style="width: 17px; height: 14px;" /></a>
          </div>
        </div>
        <div style="width: 538px; height: 358.66px; flex-shrink: 0;">
          <img src="/images/laptop/blog-detalle-islay-2.png" alt="Litoral de Islay" style="width: 100%; height: 100%; object-fit: cover;" />
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <div style="display: flex; flex-direction: column; gap: 29px; width: 300px; flex-shrink: 0;">
      <p style="margin: 0; font-family: var(--font-heading); font-weight: 700; font-size: 21.3px; color: var(--color-black);">Post Recientes</p>
      <div style="display: flex; flex-direction: column; gap: 15px; width: 100%;">
        {relatedPosts.map((post) => (
          <a href="#" style="display: flex; gap: 20px; align-items: flex-start; text-decoration: none;">
            <div style="width: 100px; height: 100px; border-radius: 8px; overflow: hidden; flex-shrink: 0;">
              <img src={post.image} alt="" style="width: 100%; height: 100%; object-fit: cover;" />
            </div>
            <div style="display: flex; flex-direction: column; gap: 4px; padding-top: 2px;">
              <p style="margin: 0; font-family: var(--font-heading); font-weight: 700; font-size: 16px; line-height: 20.8px; color: var(--color-black);">{post.title}</p>
              <p style="margin: 0; font-family: var(--font-body); font-weight: 400; font-size: 12.4px; color: rgba(18,24,34,0.6);">{post.date}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</div>

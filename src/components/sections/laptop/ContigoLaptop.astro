<!-- background-attachment:fixed = efecto parallax: el fondo queda anclado al
     viewport y la seccion lo va revelando al hacer scroll -->
<div style="position: relative; width: 1366px; height: 620px; overflow: hidden; background-image: url('/images/contigo-bg.png'); background-attachment: fixed; background-position: center; background-size: cover; background-repeat: no-repeat;">
  <!-- Gray overlay -->
  <div style="position: absolute; inset: 0; background: #f1f2f5; opacity: 0.44;"></div>

  <!-- Text -->
  <div style="position: absolute; left: 80px; top: 243px; font-size: 55px; font-family: var(--font-heading); line-height: 1; margin: 0;">
    <span style="font-weight: 800; color: #121822; letter-spacing: -0.03em;">Contigo </span>
    <span style="font-weight: 500; font-style: italic; color: #121822;">ahora</span>
  </div>
  <div style="position: absolute; left: 80px; top: 310px; font-size: 55px; font-family: var(--font-heading); line-height: 1; margin: 0;">
    <span style="font-weight: 800; color: #121822; letter-spacing: -0.03em;">Contigo </span>
    <span style="font-weight: 800; color: #d70202;">siempre.</span>
  </div>
</div>

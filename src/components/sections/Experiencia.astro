<script>
  const EXP_DATA = [
    { year: "2022", description: "Ejercí como consultora especialista pesquero ambiental.", image: null },
    { year: "2021-2022", description: "Servicio especializado en INGENIERÍA PESQUERA para consejo regional – Gobierno Regional de Arequipa.", image: "/images/imagen-9.png" },
    { year: "2019", description: "Inspectora del Gobierno Regional de Arequipa en la Gerencia Regional de la Producción.", image: null },
    { year: "2017 -2018", description: "Encargada de la Dirección Zonal de Producción Islay – Gerencia Regional de la Producción en el Gobierno Regional de Arequipa.", image: null },
    { year: "2016-2017", description: "Sub Gerente de Pesca – Gerencia Regional de la Producción en el Gobierno Regional de Arequipa.", image: null },
    { year: "2015-2016", description: "Encargada de la Dirección Zonal de Islay – Gerencia Regional de la Producción en el Gobierno Regional de Arequipa.", image: null },
    { year: "2013-2014", description: "<span style=\"white-space:nowrap\">Inspector de seguimiento control y vigilancia de recursos hidrobiológicos –</span><br/>Gerencia Regional de la Producción en el Gobierno Regional de Arequipa.", image: null },
    { year: "2012-2013", description: "Inspector y supervisor desconcentrado de recursos hidrobiológicos en el Ministerio de la Producción.", image: null },
    { year: "2011 -2012", description: "Inspectora Agricultural Services – control de descarga para el SGS del Perú S.A.C.", image: null },
    { year: "2010", description: "Asistente técnico del PIP – Servicio Nacional de Áreas Protegidas por el Estado “SERNANP”.", image: null },
  ];

  const ACTIVE_STYLE = { fontWeight: "800", fontSize: "2.8125rem", color: "#d70202" };
  const INACTIVE_STYLE = { fontWeight: "700", fontSize: "1.1875rem", color: "#121822" };

  let activeIndex = 1;
  let firstRender = true;

  function replay(el) {
    if (!el) return;
    el.classList.remove("exp-fade-slide");
    void el.offsetWidth;
    el.classList.add("exp-fade-slide");
  }

  function renderExperiencia() {
    const section = document.getElementById("trayectoria");
    if (!section) return;

    section.querySelectorAll(".exp-year").forEach((el) => {
      const i = Number(el.getAttribute("data-index"));
      const style = i === activeIndex ? ACTIVE_STYLE : INACTIVE_STYLE;
      el.style.fontWeight = style.fontWeight;
      el.style.fontSize = style.fontSize;
      el.style.color = style.color;
    });

    section.querySelectorAll(".exp-dot").forEach((el) => {
      const i = Number(el.getAttribute("data-index"));
      const redDot = el.querySelector(".exp-dot-red");
      if (redDot) redDot.style.opacity = i === activeIndex ? "1" : "0";
    });

    const description = document.getElementById("exp-description");
    if (description) description.innerHTML = EXP_DATA[activeIndex].description;

    const imageEl = document.getElementById("exp-image");
    const placeholderEl = document.getElementById("exp-placeholder");
    const currentImage = EXP_DATA[activeIndex].image;
    if (imageEl && placeholderEl) {
      if (currentImage) {
        imageEl.src = currentImage;
        imageEl.style.display = "block";
        placeholderEl.style.display = "none";
      } else {
        imageEl.style.display = "none";
        placeholderEl.style.display = "block";
      }
    }

    if (!firstRender) {
      replay(document.getElementById("exp-description-wrap"));
      replay(document.getElementById("exp-image-wrap"));
    }
    firstRender = false;
  }

  document.getElementById("exp-next")?.addEventListener("click", () => {
    if (activeIndex < EXP_DATA.length - 1) {
      activeIndex++;
      renderExperiencia();
    }
  });

  document.getElementById("exp-prev")?.addEventListener("click", () => {
    if (activeIndex > 0) {
      activeIndex--;
      renderExperiencia();
    }
  });

  renderExperiencia();
</script>

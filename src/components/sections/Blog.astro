---
// Las dos notas del home ahora vienen de Bravo (las 2 más recientes).
import type { BravoArticle } from "../../lib/bravo";
import { articleHref } from "../../lib/bravo";

export interface Props {
  articles: BravoArticle[];
  mainImage?: string;
}

const { articles, mainImage = "/images/sosi-blog.png" } = Astro.props;

// El diseño pone en negrita el arranque del título hasta los dos puntos y deja el
// resto en peso medio. Bravo entrega el título plano, así que el corte se deriva:
// si no hay dos puntos va todo en negrita, y no se pierde nada.
function partirTitulo(title: string): [string, string] {
  const i = title.indexOf(":");
  return i === -1 ? [title, ""] : [title.slice(0, i + 1), title.slice(i + 1)];
}

// Coordenadas de cada ranura del maquetado. Se recorren en vez de estar duplicadas,
// así la sección no se rompe si hay una sola nota publicada.
const RANURAS = [
  { thumbTop: "28.64%", tituloTop: "29.11%", descTop: "39.76%", linkTop: "49.70%" },
  { thumbTop: "61.78%", tituloTop: "61.78%", descTop: "71.24%", linkTop: "82.37%" },
];

const destacadas = articles.slice(0, RANURAS.length).map((a, i) => ({
  ...RANURAS[i],
  href: articleHref(a.slug),
  image: a.cover_image_url ?? "/images/blog-listado-card-placeholder.png",
  titulo: partirTitulo(a.title),
  excerpt: a.excerpt ?? "",
}));
---

<div
  class="relative overflow-hidden"
  style="width:var(--page);height:845px;background:var(--color-gray-bg)"
>
  <!-- Title -->
  <p
    class="absolute z-[2] m-0"
    style="
      left:10.42%;
      top:13.37%;
      font-size:clamp(2rem,3.91vw,4.6875rem);
      line-height:1;
    "
  >
    <span style="font-family:var(--font-heading);font-weight:800;color:var(--color-black);letter-spacing:-0.1172vw;">Ideas </span>
    <span style="font-family:var(--font-heading);font-weight:400;color:var(--color-red);">en voz alta</span>
  </p>

  <!-- Pill: Ver todo -->
  <a
    href="/blog"
    class="blog-pill absolute z-[5] flex items-center justify-center rounded-[76px] no-underline uppercase"
    style="
      left:73.28%;
      top:14.91%;
      width:8.11%;
      height:4.73%;
      font-family:var(--font-body);
      font-weight:400;
      font-size:clamp(0.6875rem,0.625vw,0.75rem);
    "
  >
    Ver todo
  </a>

  <!-- Main card -->
  <div
    class="absolute z-[1] overflow-hidden rounded-[10px]"
    style="left:10.42%;top:28.64%;width:35.05%;height:60.24%;background:#000;"
  >
    <!-- Background -->
    <img src="/images/blog-featured-bg.png" alt="" class="absolute inset-0 w-full h-full object-cover" />

    <!-- Sosi photo centered -->
    <img
      src={mainImage}
      alt="Sosi Aspilcueta"
      class="absolute object-contain"
      style="left:21.66%;top:8.84%;width:56.83%;height:91.16%;"
    />

    <!-- Bottom gradient overlay -->
    <div
      class="absolute rounded-b-[10px]"
      style="
        left:0;
        bottom:0;
        width:100%;
        height:25.34%;
        background:linear-gradient(180deg,rgba(18,24,34,0) 0%,#121822 100%);
        z-index:1;
      "
    ></div>

    <!-- Conoce más sobre mí -->
    <p
      class="absolute z-[2] m-0"
      style="
        left:5.12%;
        bottom:12.29%;
        font-family:var(--font-heading);
        font-weight:500;
        font-size:clamp(1.25rem,1.30vw,1.5625rem);
        color:var(--color-white);
        line-height:2.1875rem;
      "
    >
      Conoce más sobre mí
    </p>

    <!-- Leer artículo (main card) -->
    <a
      href="/blog"
      class="blog-link blog-link-on-dark absolute z-[2]"
      style="
        left:73.70%;
        top:83.89%;
        font-family:var(--font-heading);
        font-weight:500;
        font-size:clamp(0.875rem,1.04vw,1.25rem);
        line-height:1;
      "
    >
      Leer artículo
    </a>
  </div>

  {destacadas.map((nota) => (
    <Fragment>
      <!-- Thumbnail -->
      <div
        class="absolute z-[1] overflow-hidden rounded-[10px]"
        style={`left:47.40%;top:${nota.thumbTop};width:11.93%;height:27.10%;`}
      >
        <img src={nota.image} alt="" class="w-full h-full object-cover" />
      </div>

      <!-- Título -->
      <p
        class="absolute z-[2] m-0"
        style={`
          left:60.78%;
          top:${nota.tituloTop};
          max-width:20.63%;
          font-family:var(--font-heading);
          font-weight:500;
          font-size:clamp(0.875rem,1.04vw,1.25rem);
          color:var(--color-black);
          line-height:1.5rem;
        `}
      >
        <span style="font-weight:700;">{nota.titulo[0]}</span>
        <span style="font-weight:500;">{nota.titulo[1]}</span>
      </p>

      <!-- Bajada -->
      <p
        class="absolute z-[2] m-0"
        style={`
          left:60.78%;
          top:${nota.descTop};
          max-width:20.63%;
          font-family:var(--font-body);
          font-weight:400;
          font-size:clamp(0.75rem,0.83vw,1rem);
          color:var(--color-black);
          line-height:1.5rem;
        `}
      >
        {nota.excerpt}
      </p>

      <!-- Leer artículo -->
      <a
        href={nota.href}
        class="blog-link absolute z-[2]"
        style={`
          left:60.78%;
          top:${nota.linkTop};
          font-family:var(--font-heading);
          font-weight:500;
          font-size:clamp(0.875rem,1.04vw,1.25rem);
          line-height:1;
        `}
      >
        Leer artículo
      </a>
    </Fragment>
  ))}
</div>

<style>
  .blog-pill {
    border: 1px solid var(--color-red);
    color: var(--color-red);
    background: transparent;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .blog-pill:hover,
  .blog-pill:focus-visible {
    background: var(--color-red);
    color: var(--color-white);
  }

  /* "Leer articulo": subrayado que aparece al pasar el cursor */
  .blog-link {
    color: var(--color-red);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 4px;
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }

  .blog-link:hover,
  .blog-link:focus-visible {
    color: var(--color-red-dark);
    text-decoration-color: currentColor;
  }

  /* El de la card destacada va sobre foto oscura: aclarar en vez de oscurecer */
  .blog-link-on-dark:hover,
  .blog-link-on-dark:focus-visible {
    color: var(--color-white);
  }
</style>

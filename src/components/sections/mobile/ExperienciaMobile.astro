<script>
  document.querySelectorAll(".exp-accordion-toggle-mobile").forEach((toggle) => {
    toggle.addEventListener("click", () => {
      const targetId = toggle.getAttribute("data-target");
      const desc = targetId ? document.getElementById(targetId) : null;
      const arrow = toggle.querySelector(".exp-accordion-arrow-mobile") as HTMLElement | null;
      if (!desc) return;
      const isOpen = desc.style.maxHeight !== "0px" && desc.style.maxHeight !== "";
      if (isOpen) {
        desc.style.maxHeight = "0px";
        desc.style.opacity = "0";
        if (arrow) arrow.style.transform = "rotate(0deg)";
      } else {
        desc.style.maxHeight = desc.scrollHeight + "px";
        desc.style.opacity = "1";
        if (arrow) arrow.style.transform = "rotate(90deg)";
      }
    });
  });
</script>

<script>
  const EXP_DATA_MOBILE = [
    { year: "2022", description: "Ejercí como consultora especialista pesquero ambiental.", image: null },
    { year: "2021-2022", description: "Servicio especializado en INGENIERÍA PESQUERA para consejo regional – Gobierno Regional de Arequipa.", image: "/landing-sosi/images/mobile/experiencia-main.jpg" },
    { year: "2019", description: "Inspectora del Gobierno Regional de Arequipa en la Gerencia Regional de la Producción.", image: null },
    { year: "2017 -2018", description: "Encargada de la Dirección Zonal de Producción Islay – Gerencia Regional de la Producción en el Gobierno Regional de Arequipa.", image: null },
    { year: "2016-2017", description: "Sub Gerente de Pesca – Gerencia Regional de la Producción en el Gobierno Regional de Arequipa.", image: null },
    { year: "2015-2016", description: "Encargada de la Dirección Zonal de Islay – Gerencia Regional de la Producción en el Gobierno Regional de Arequipa.", image: null },
    { year: "2013-2014", description: "Inspector de seguimiento control y vigilancia de recursos hidrobiológicos – Gerencia Regional de la Producción en el Gobierno Regional de Arequipa.", image: null },
    { year: "2012-2013", description: "Inspector y supervisor desconcentrado de recursos hidrobiológicos en el Ministerio de la Producción.", image: null },
    { year: "2011 -2012", description: "Inspectora Agricultural Services – control de descarga para el SGS del Perú S.A.C.", image: null },
    { year: "2010", description: "Asistente técnico del PIP – Servicio Nacional de Áreas Protegidas por el Estado “SERNANP”.", image: null },
  ];

  const ACTIVE_STYLE_MOBILE = { fontWeight: "800", fontSize: "28px", color: "#d70202" };
  const INACTIVE_STYLE_MOBILE = { fontWeight: "700", fontSize: "18px", color: "#121822" };

  const yearElsMobile = document.querySelectorAll(".exp-year-mobile") as NodeListOf<HTMLElement>;
  const dotElsMobile = document.querySelectorAll(".exp-dot-mobile") as NodeListOf<HTMLImageElement>;
  const descriptionElMobile = document.getElementById("exp-description-mobile");
  const imageElMobile = document.getElementById("exp-image-mobile") as HTMLImageElement | null;
  const placeholderElMobile = document.getElementById("exp-placeholder-mobile");

  function replayFadeMobile(el: HTMLElement | null) {
    if (!el) return;
    el.classList.remove("exp-fade-slide");
    void el.offsetWidth;
    el.classList.add("exp-fade-slide");
  }

  function setActiveExperienciaMobile(index: number) {
    yearElsMobile.forEach((el) => {
      const i = Number(el.getAttribute("data-index"));
      const style = i === index ? ACTIVE_STYLE_MOBILE : INACTIVE_STYLE_MOBILE;
      el.style.fontWeight = style.fontWeight;
      el.style.fontSize = style.fontSize;
      el.style.color = style.color;
    });

    dotElsMobile.forEach((el) => {
      const i = Number(el.getAttribute("data-index"));
      el.src = i === index ? "/landing-sosi/images/icons/dot-red.svg" : "/landing-sosi/images/icons/dot.svg";
    });

    const data = EXP_DATA_MOBILE[index];
    if (descriptionElMobile) descriptionElMobile.textContent = data.description;
    replayFadeMobile(descriptionElMobile);

    if (imageElMobile && placeholderElMobile) {
      if (data.image) {
        imageElMobile.src = data.image;
        imageElMobile.style.display = "block";
        placeholderElMobile.style.display = "none";
      } else {
        imageElMobile.style.display = "none";
        placeholderElMobile.style.display = "block";
      }
    }
  }

  yearElsMobile.forEach((el) => {
    el.addEventListener("click", () => setActiveExperienciaMobile(Number(el.getAttribute("data-index"))));
  });
  dotElsMobile.forEach((el) => {
    el.addEventListener("click", () => setActiveExperienciaMobile(Number(el.getAttribute("data-index"))));
  });
</script>

---
// El carrusel arranca con la diapositiva de bio (fija, no es una nota) y sigue con las
// notas publicadas en Bravo. Antes las notas estaban escritas a mano en el array de JS.
//
// Los datos viajan al script del cliente por un <script type="application/json">: el
// script de abajo es un módulo TypeScript y no puede leer el frontmatter directo.
import type { BravoArticle } from "../../../lib/bravo";
import { articleHref } from "../../../lib/bravo";

export interface Props {
  articles: BravoArticle[];
}

const { articles } = Astro.props;

const SLIDE_BIO = {
  badge: "ENE",
  photo: "/images/mobile/blog-featured-mobile.png",
  title: "Conoce más sobre mí",
  date: "30 DE JULIO 2026",
  description:
    "Soy Sosi Aspilcueta, nací el 20 de enero de 1986 en Mejía, un encantador distrito ubicado en Arequipa, Perú.",
  readMore: "Leer nota completa",
  href: "/blog",
};

const slides = [
  SLIDE_BIO,
  ...articles.slice(0, 3).map((a) => ({
    badge: null,
    photo: a.cover_image_url ?? "/images/mobile/blog-listado-card-placeholder.png",
    title: a.title,
    date: null,
    description: a.excerpt ?? "",
    readMore: "Leer artículo",
    href: articleHref(a.slug),
  })),
];
---

<div style="position: relative; width: 430px; height: 730px; background: #f5f7fa;">
  <!-- Title -->
  <div style="position: absolute; left: 25px; top: 52px; font-size: 32px; font-family: var(--font-heading); margin: 0;">
    <p style="font-weight: 700; color: #121822; line-height: 1; margin: 0;">Ideas</p>
    <p style="font-weight: 500; color: #d70202; line-height: 1; margin: 0;">en voz alta</p>
  </div>

  <!-- Ver todo pill -->
  <a href="/blog" class="blog-ver-todo-mobile" style="position: absolute; left: 25px; top: 136px; display: flex; align-items: center; justify-content: center; width: 125px; height: 32px; border: 1px solid #d70202; border-radius: 76px; cursor: pointer; text-decoration: none;">
    <span class="blog-ver-todo-text-mobile" style="font-size: 10px; text-transform: uppercase;">Ver todo</span>
  </a>

  <!-- Blog card -->
  <div id="blog-card-mobile" style="position: absolute; left: 44px; top: 216px; width: 343px; height: 270px; border-radius: 10px; overflow: hidden; background: #1a1f2e; cursor: pointer;">
    <!-- Slide photo (full-bleed, single flattened image per slide) -->
    <img id="blog-photo-mobile" src="/images/mobile/blog-featured-mobile.png" alt="" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;" />
    <!-- Month badge -->
    <p id="blog-badge-mobile" style="position: absolute; left: 26px; top: 18px; font-family: var(--font-heading); font-weight: 500; font-size: 13px; color: #fff; text-transform: uppercase; margin: 0;">ENE</p>
    <!-- Gradient overlay at bottom -->
    <div style="position: absolute; bottom: 0; left: 0; right: 0; height: 64px; background: linear-gradient(to bottom, rgba(18,24,34,0), #121822);"></div>
    <!-- Text overlay -->
    <p id="blog-title-mobile" class="blog-fade-mobile" style="position: absolute; left: 26px; right: 26px; bottom: 34px; font-family: var(--font-heading); font-weight: 700; font-size: 17px; color: #fff; margin: 0;">Conoce más sobre mí</p>
  </div>

  <!-- Prev / Next arrows, outside the card, at the screen edges -->
  <img id="blog-prev-mobile" src="/images/icons/arrow-left.svg" alt="Anterior" class="cursor-pointer" style="position: absolute; left: 4px; top: 351px; transform: translateY(-50%); width: 32px; height: 32px;" />
  <img id="blog-next-mobile" src="/images/icons/arrow-right.svg" alt="Siguiente" class="cursor-pointer" style="position: absolute; right: 4px; top: 351px; transform: translateY(-50%); width: 32px; height: 32px;" />

  <!-- Date -->
  <p id="blog-date-mobile" style="position: absolute; left: 55px; top: 506px; font-size: 11px; font-weight: 400; color: #2e3135; margin: 0;">30 DE JULIO 2026</p>

  <!-- Bio text -->
  <p id="blog-description-mobile" class="blog-fade-mobile" style="position: absolute; left: 54px; top: 535px; width: 327px; font-size: 13px; font-weight: 400; color: #2e3135; line-height: 20px; margin: 0;">Soy Sosi Aspilcueta, nací el 20 de enero de 1986 en Mejía, un encantador distrito ubicado en Arequipa, Perú.</p>

  <!-- Read more link -->
  <a id="blog-readmore-mobile" href="/blog" style="position: absolute; left: 55px; top: 611px; font-size: 14px; font-weight: 400; color: #e74942; margin: 0; cursor: pointer; text-decoration: none;">Leer nota completa</a>

  <!-- Carousel dots: uno por diapositiva, que ahora dependen de cuántas notas haya -->
  <div style="position: absolute; left: 0; right: 0; top: 653px; display: flex; justify-content: center; gap: 8px;">
    {slides.map((_, i) => (
      <div
        class="blog-dot-mobile"
        data-index={i}
        style={`width: 9px; height: 9px; background: ${i === 0 ? "#d70202" : "#cecece"}; border-radius: 50%; cursor: pointer;`}
      ></div>
    ))}
  </div>
</div>

<script type="application/json" id="blog-data-mobile" set:html={JSON.stringify(slides)}></script>

<style>
  @keyframes blog-fade-mobile-anim { from { opacity: 0; } to { opacity: 1; } }
  .blog-fade-mobile { animation: blog-fade-mobile-anim 0.35s ease; }

  .blog-ver-todo-mobile {
    transition: background 0.25s ease;
  }
  .blog-ver-todo-mobile:hover {
    background: #d70202;
  }
  .blog-ver-todo-text-mobile {
    color: #d70202;
    transition: color 0.25s ease;
  }
  .blog-ver-todo-mobile:hover .blog-ver-todo-text-mobile {
    color: #fff;
  }
</style>

<script>
  interface BlogSlideMobile {
    badge: string | null;
    photo: string;
    title: string;
    date: string | null;
    description: string;
    readMore: string;
    href: string;
  }

  // Las diapositivas las arma el frontmatter desde Bravo y viajan en el <script
  // type="application/json"> de arriba.
  const dataEl = document.getElementById("blog-data-mobile");
  const BLOG_DATA_MOBILE: BlogSlideMobile[] = dataEl?.textContent
    ? JSON.parse(dataEl.textContent)
    : [];

  let blogIndexMobile = 0;

  const cardEl = document.getElementById("blog-card-mobile");
  const photoEl = document.getElementById("blog-photo-mobile") as HTMLImageElement | null;
  const badgeEl = document.getElementById("blog-badge-mobile");
  const titleEl = document.getElementById("blog-title-mobile");
  const dateEl = document.getElementById("blog-date-mobile");
  const descriptionEl = document.getElementById("blog-description-mobile");
  const readMoreEl = document.getElementById("blog-readmore-mobile") as HTMLAnchorElement | null;
  const dotEls = document.querySelectorAll(".blog-dot-mobile") as NodeListOf<HTMLElement>;

  function replayFadeBlogMobile(el: HTMLElement | null) {
    if (!el) return;
    el.classList.remove("blog-fade-mobile");
    void el.offsetWidth;
    el.classList.add("blog-fade-mobile");
  }

  function renderBlogMobile() {
    const data = BLOG_DATA_MOBILE[blogIndexMobile];
    if (!data) return;

    if (photoEl) photoEl.src = data.photo;
    if (badgeEl) {
      badgeEl.style.display = data.badge ? "block" : "none";
      if (data.badge) badgeEl.textContent = data.badge;
    }

    if (titleEl) titleEl.textContent = data.title;
    if (dateEl) dateEl.style.display = data.date ? "block" : "none";
    if (dateEl && data.date) dateEl.textContent = data.date;
    if (descriptionEl) descriptionEl.textContent = data.description;
    if (readMoreEl) {
      readMoreEl.textContent = data.readMore;
      readMoreEl.href = data.href;
    }
    if (cardEl) cardEl.dataset.href = data.href;

    replayFadeBlogMobile(titleEl);
    replayFadeBlogMobile(descriptionEl);

    dotEls.forEach((dot) => {
      const i = Number(dot.getAttribute("data-index"));
      dot.style.background = i === blogIndexMobile ? "#d70202" : "#cecece";
    });
  }

  function goToBlogMobile(index: number) {
    if (BLOG_DATA_MOBILE.length === 0) return;
    blogIndexMobile = (index + BLOG_DATA_MOBILE.length) % BLOG_DATA_MOBILE.length;
    renderBlogMobile();
  }

  document.getElementById("blog-prev-mobile")?.addEventListener("click", () => goToBlogMobile(blogIndexMobile - 1));
  document.getElementById("blog-next-mobile")?.addEventListener("click", () => goToBlogMobile(blogIndexMobile + 1));
  dotEls.forEach((dot) => {
    dot.addEventListener("click", () => goToBlogMobile(Number(dot.getAttribute("data-index"))));
  });

  // Pinta la primera diapositiva ya con los datos de Bravo (el HTML trae la de bio).
  renderBlogMobile();

  cardEl?.addEventListener("click", () => {
    const href = cardEl.dataset.href;
    if (href) window.location.href = href;
  });
</script>

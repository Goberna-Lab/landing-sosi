<div style="position: relative; width: 430px; height: 730px; background: #f5f7fa;">
  <!-- Title -->
  <div style="position: absolute; left: 25px; top: 52px; font-size: 32px; font-family: var(--font-heading); margin: 0;">
    <p style="font-weight: 700; color: #121822; line-height: 1; margin: 0;">Ideas</p>
    <p style="font-weight: 500; color: #d70202; line-height: 1; margin: 0;">en voz alta</p>
  </div>

  <!-- Ver todo pill -->
  <div style="position: absolute; left: 25px; top: 136px; display: flex; align-items: center; justify-content: center; width: 125px; height: 32px; border: 1px solid #d70202; border-radius: 76px; cursor: pointer;">
    <span style="font-size: 10px; color: #d70202; text-transform: uppercase;">Ver todo</span>
  </div>

  <!-- Blog card -->
  <div style="position: absolute; left: 44px; top: 216px; width: 343px; height: 270px; border-radius: 10px; overflow: hidden; background: #1a1f2e;">
    <!-- Noise background -->
    <img src="/images/mobile/fondo-ruido.png" alt="" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;" />
    <!-- Sosi photo -->
    <div style="position: absolute; left: 72px; top: 51px; width: 221px; height: 219px;">
      <img src="/images/mobile/sosi-v3.png" alt="Sosi Aspilcueta" style="width: auto; height: 100%; min-height: 294px; object-fit: cover;" />
    </div>
    <!-- Month badge -->
    <p style="position: absolute; left: 26px; top: 18px; font-family: var(--font-heading); font-weight: 500; font-size: 13px; color: #fff; text-transform: uppercase; margin: 0;">ENE</p>
    <!-- Gradient overlay at bottom -->
    <div style="position: absolute; bottom: 0; left: 0; right: 0; height: 64px; background: linear-gradient(to bottom, rgba(18,24,34,0), #121822);"></div>
    <!-- Text overlay -->
    <p style="position: absolute; left: 26px; bottom: 70px; font-family: var(--font-heading); font-weight: 700; font-size: 17px; color: #fff; margin: 0;">Conoce más sobre mí</p>
  </div>

  <!-- Date -->
  <p style="position: absolute; left: 55px; top: 506px; font-size: 11px; font-weight: 400; color: #2e3135; margin: 0;">30 DE JULIO 2026</p>

  <!-- Bio text -->
  <p style="position: absolute; left: 54px; top: 535px; width: 327px; font-size: 13px; font-weight: 400; color: #2e3135; line-height: 20px; margin: 0;">Soy Sosi Aspilcueta, nací el 20 de enero de 1986 en Mejía, un encantador distrito ubicado en Arequipa, Perú.</p>

  <!-- Read more link -->
  <p style="position: absolute; left: 55px; top: 611px; font-size: 14px; font-weight: 400; color: #e74942; margin: 0; cursor: pointer;">Leer nota completa</p>

  <!-- Carousel dots -->
  <div style="position: absolute; left: 185px; top: 653px; display: flex; gap: 8px;">
    <div style="width: 9px; height: 9px; background: #d70202; border-radius: 50%;"></div>
    <div style="width: 9px; height: 9px; background: #cecece; border-radius: 50%;"></div>
    <div style="width: 9px; height: 9px; background: #cecece; border-radius: 50%;"></div>
    <div style="width: 9px; height: 9px; background: #cecece; border-radius: 50%;"></div>
  </div>
</div>

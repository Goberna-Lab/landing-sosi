  </div>

  <!-- Dark multiply overlay -->
  <div style="position: absolute; top: 0; left: 0; right: 0; height: 620px; background: linear-gradient(to top, rgba(0,0,0,0) 8.8%, #696f7e 74.77%); mix-blend-mode: multiply;"></div>

  <!-- Tagline -->
  <p style="position: absolute; left: 24px; top: 38px; font-size: 12px; font-weight: 400; color: #fff; text-transform: uppercase; letter-spacing: 0.01em; white-space: nowrap; margin: 0;">
    Teniente Alcaldesa · Mejía, Arequipa
  </p>

  <!-- Name -->
  <p style="position: absolute; left: 24px; top: 110px; font-size: 41px; font-weight: 800; color: #fff; white-space: nowrap; margin: 0; font-family: var(--font-heading);">
    Sosi Aspilcueta
  </p>

  <!-- Slogan -->
  <p style="position: absolute; left: 24px; top: 162px; font-size: 21px; font-weight: 800; color: #fff; white-space: nowrap; margin: 0; font-family: var(--font-heading);">
    Siempre al servicio de Mejía
  </p>

  <!-- Description -->
  <div style="position: absolute; left: 24px; top: 231px; font-size: 15px; font-weight: 400; color: #fff; line-height: 20px; width: 292px; letter-spacing: 0.04em; margin: 0;">

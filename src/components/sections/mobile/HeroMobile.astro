  </div>

  <!-- CTA Button -->
  <a href="#sobre-mi" style="position: absolute; left: 24px; top: 323px; display: flex; align-items: center; justify-content: center; width: 186px; height: 40px; background: #d70202; border-radius: 6px; font-size: 13px; color: #fff; text-decoration: none;">
    CONOCE MI HISTORIA
  </a>

  <!-- Photo at bottom -->
  <div style="position: absolute; left: 0; top: 443px; width: 430px; height: 489px; overflow: hidden;">
    <img src="/landing-sosi/images/mobile/sosi-v3.png" alt="Sosi Aspilcueta" style="width: auto; height: 100%; min-width: 520px; object-fit: cover; object-position: -54px 0;" />
  </div>
  <img src="/landing-sosi/images/mobile/sosi-v3-mask.png" alt="" style="position: absolute; left: 0; top: 443px; width: 430px; height: 489px; pointer-events: none; opacity: 0;" />

<div id="stats-mobile" style="position: relative; width: 430px; height: 620px; overflow: hidden;">
  <!-- Immersive background -->
  <div style="position: absolute; left: -146px; top: 0; width: 930px; height: 620px;">
    <img src="/images/mobile/immersive.jpg" alt="" style="width: 100%; height: 100%; object-fit: cover;" />
  </div>
  <!-- Dark overlay -->
  <div style="position: absolute; inset: 0; background: rgba(18,24,34,0.64);"></div>

  <!-- Title -->
  <div style="position: absolute; left: 24px; top: 90px; font-family: var(--font-heading); color: #fff; margin: 0;">
    <p style="font-weight: 700; font-size: 38px; line-height: 1; margin: 0;">La experiencia</p>
    <p style="font-weight: 500; font-size: 33px; line-height: 1; margin: 0; margin-top: 5px;">también se mide</p>
  </div>

  <!-- 15+ -->
  <div style="position: absolute; left: 24px; top: 193px;">
    <span class="stat-number-mobile" data-count-to="15" style="font-family: var(--font-heading); font-weight: 800; font-size: 65px; color: #fff; letter-spacing: -0.03em;">0</span>
    <span style="font-family: var(--font-heading); font-weight: 600; font-size: 63px; color: #d70202;">+</span>
  </div>
  <p style="position: absolute; left: 26px; top: 270px; font-size: 16px; font-weight: 400; color: #fff; margin: 0; font-family: var(--font-heading);">Años de experiencia pública</p>

  <!-- 10 -->
  <p class="stat-number-mobile" data-count-to="10" style="position: absolute; left: 32px; top: 315px; font-family: var(--font-heading); font-weight: 800; font-size: 65px; color: #fff; letter-spacing: -0.03em; margin: 0;">0</p>
  <p style="position: absolute; left: 24px; top: 391px; font-size: 16px; font-weight: 400; color: #fff; margin: 0; font-family: var(--font-heading);">Cargos en el Gobierno Regional</p>

  <!-- 90% -->
  <div style="position: absolute; left: 31px; top: 438px;">
    <span class="stat-number-mobile" data-count-to="90" style="font-family: var(--font-heading); font-weight: 800; font-size: 65px; color: #fff; letter-spacing: -0.03em;">0</span>
    <span style="font-family: var(--font-heading); font-weight: 800; font-size: 52px; color: #d70202;">%</span>
  </div>
  <p style="position: absolute; left: 24px; top: 514px; font-size: 16px; font-weight: 400; color: #fff; margin: 0; font-family: var(--font-heading);">Ejecución presupuestal promedio</p>
</div>

<script>
  function animateCountMobile(el: HTMLElement, target: number, duration = 1500) {
    const start = performance.now();
    function step(now: number) {
      const progress = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      el.textContent = String(Math.round(eased * target));
      if (progress < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }

  const statsSectionMobile = document.getElementById("stats-mobile");
  const statNumbersMobile = statsSectionMobile?.querySelectorAll(".stat-number-mobile") as NodeListOf<HTMLElement> | undefined;

  if (statsSectionMobile && statNumbersMobile && statNumbersMobile.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            statNumbersMobile.forEach((el) => {
              const target = Number(el.getAttribute("data-count-to"));
              animateCountMobile(el, target);
            });
            observer.disconnect();
          }
        });
      },
      { threshold: 0.3 }
    );
    observer.observe(statsSectionMobile);
  }
</script>
